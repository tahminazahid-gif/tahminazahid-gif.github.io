2. Remove the comment markers around the block below.

<section id="intro" class="alt">
  <div class="wrap">
    <h2>My Introduction Video</h2>
    <p class="sub">A short video about me</p>
    <div class="intro-card">
      <div>
        <h3>Hear it from me</h3>
        <p>My academic background, skills, interests and career aspirations, in my own words.</p>
      </div>
      <div class="phone">
        <video controls preload="metadata" poster="tahmina-portfolio/assets/images/intro-poster.jpg" playsinline aria-label="Introduction video by Tahmina Zahid">
          <source src="tahmina-portfolio/assets/videos/introduction.mp4" type="video/mp4">
