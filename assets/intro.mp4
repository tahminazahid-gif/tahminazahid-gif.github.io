<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tahmina Zahid | E-Portfolio</title>
  <meta name="description" content="E-Portfolio of Tahmina Zahid, Industrial and Production Engineering student at AIUB.">
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <nav aria-label="Main">
    <a class="logo grad" href="#home">Tahmina Zahid</a>
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#education">Education</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#languages">Languages</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="#certificates">Certificates</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<main>

<!-- ============ HOME: photo first ============ -->
<div class="hero" id="home">
  <div class="wrap">
    <div class="avatar" role="img" aria-label="Profile picture of Tahmina Zahid">
      TZ
      <img src="tahmina-portfolio/assets/images/profile.jpg" alt="Tahmina Zahid" onerror="this.remove()">
    </div>
    <h1>Tahmina <span class="grad">Zahid</span></h1>
    <p class="role">Industrial and Production Engineering Student</p>
    <p class="place">American International University-Bangladesh (AIUB) · Dhaka</p>
    <div class="btn-row center">
      <a class="btn" href="#projects">View my work</a>
      <a class="btn ghost" href="#contact">Contact me</a>
    </div>
  </div>
</div>

<!-- ============ ABOUT ME ============ -->
<section id="about">
  <div class="wrap">
    <h2>About Me</h2>
    <p class="sub">My academic background, interests and goals</p>
    <div class="narrow about-text">
      <p>I am a motivated Industrial and Production Engineering student at American International University-Bangladesh, with strong analytical and problem-solving skills.</p>
      <p>I want to apply my engineering knowledge to process improvement, productivity enhancement and quality management, while gaining practical industry experience.</p>
      <p>I won a Silver Medal at the International Research Olympiad and I serve as a Youth Ambassador for Amra Notun Network.</p>
    </div>
  </div>
</section>

