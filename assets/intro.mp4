-->
<section id="intro-video">
  <h2>Introduction Video</h2>
  <p>A short introduction about me</p>
  <div class="video-wrap">
    <video controls preload="metadata" playsinline>
      <source src="/tahmina-portfolio/assets/intro.mp4.mp4" type="video/mp4">
    </video>
  </div>
</section>
<style>
  #intro-video { text-align: center; padding: 60px 20px; }
  #intro-video .video-wrap { max-width: 360px; margin: 0 auto; }
  #intro-video video { width: 100%; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,.2); }
</style>
<!-- ============ EDUCATION ============ -->
<section id="education" class="alt">
  <div class="wrap narrow">
    <h2>Education</h2>
    <p class="sub">My academic journey</p>
    <div class="rows">

      <div class="row">
        <div class="logo-box">AIUB<img src="tahmina-portfolio/assets/logos/aiub.png" alt="AIUB logo" onerror="this.remove()"></div>
        <div>
          <div class="when">Present</div>
          <h3>BSc in Industrial and Production Engineering</h3>
          <p>American International University-Bangladesh</p>
          <span class="gpa">CGPA 3.40</span>
        </div>
      </div>

      <div class="row">
        <div class="logo-box">BUSSC<img src="tahmina-portfolio/assets/logos/bir-uttam-shaheed-samad.png" alt="Bir Uttam Shaheed Samad School and College logo" onerror="this.remove()"></div>
        <div>
          <div class="when">2023</div>
          <h3>Higher Secondary Certificate (HSC)</h3>
          <p>Bir Uttam Shaheed Samad School and College, Rangpur</p>
          <span class="gpa">GPA 4.25</span>
        </div>
      </div>

      <div class="row">
        <div class="logo-box">BGPSC<img src="tahmina-portfolio/assets/logos/border-guard-public-school.png" alt="Border Guard Public School and College logo" onerror="this.remove()"></div>
        <div>
          <div class="when">2021</div>
          <h3>Secondary School Certificate (SSC)</h3>
          <p>Border Guard Public School and College, Rangpur</p>
          <span class="gpa">GPA 5.00</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============ SKILLS ============ -->
<section id="skills">
  <div class="wrap">
    <h2>Skills</h2>
    <p class="sub">Engineering, software and professional skills</p>
    <div class="grid">
      <div class="card skill-group">
        <h3>Engineering skills</h3>
        <div class="chips">
          <span class="chip">Productivity analysis</span><span class="chip">Problem solving</span><span class="chip">Quality management</span><span class="chip">Process improvement</span>
        </div>
      </div>
      <div class="card skill-group">
        <h3>Software skills</h3>
        <div class="chips">
          <span class="chip">AutoCAD</span><span class="chip">MS Excel</span><span class="chip">MS Word</span><span class="chip">MS PowerPoint</span>
        </div>
      </div>
      <div class="card skill-group">
        <h3>Professional skills</h3>
        <div class="chips">
          <span class="chip">Analytical thinking</span><span class="chip">Communication</span><span class="chip">Teamwork</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ PROJECTS AND ACHIEVEMENTS ============ -->
<section id="projects" class="alt">
  <div class="wrap">
    <h2>Projects and Achievements</h2>
    <p class="sub">Recognition and activities</p>
    <div class="brands">
      <div class="brand">
        <div class="logo-box big">IRO<img src="tahmina-portfolio/assets/logos/international-research-olympiad.png" alt="International Research Olympiad logo" onerror="this.remove()"></div>
        <h3>International Research Olympiad</h3>
        <p>Silver Medalist</p>
      </div>
      <div class="brand">
        <div class="logo-box big">ANN<img src="tahmina-portfolio/assets/logos/amra-notun-network.png" alt="Amra Notun Network logo" onerror="this.remove()"></div>
        <h3>Amra Notun Network</h3>
        <p>Youth Ambassador</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ LANGUAGES ============ -->
<section id="languages">
  <div class="wrap narrow">
    <h2>Languages</h2>
    <p class="sub">Languages I speak</p>
    <div class="card" style="padding-top:12px;padding-bottom:12px">
      <div class="lang"><span><strong>English</strong></span><span class="muted">Fluent</span></div>
      <div class="lang" style="border:0"><span><strong>Bangla</strong></span><span class="muted">Fluent</span></div>
    </div>
  </div>
</section>

<!-- ============ WORK EXPERIENCE ============ -->
<section id="experience" class="alt">
  <div class="wrap narrow">
    <h2>Work Experience</h2>
    <p class="sub">Practical experience</p>
    <div class="rows">
      <div class="row">
        <div>
          <div class="when">October 2025</div>
          <h3>Academic Manufacturing Projects</h3>
          <ul>
            <li>Production process analysis and improvement.</li>
            <li>Quality control in manufacturing.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CERTIFICATES ============ -->
<section id="certificates">
  <div class="wrap">
    <h2>Certificates</h2>
    <p class="sub">Click a certificate to open it in full size.</p>
    <div class="certs">
      <a class="cert" href="tahmina-portfolio/assets/certificates/hsc-certificate.jpg" target="_blank" rel="noopener">
        <img src="tahmina-portfolio/assets/certificates/hsc-certificate.jpg" alt="HSC certificate, Board of Intermediate and Secondary Education, Dinajpur" loading="lazy">
        <div><h3>Higher Secondary Certificate, 2023</h3><p>GPA 4.25 out of 5.00, Science group</p></div>
      </a>
      <a class="cert" href="tahmina-portfolio/assets/certificates/ssc-certificate.jpg" target="_blank" rel="noopener">
        <img src="tahmina-portfolio/assets/certificates/ssc-certificate.jpg" alt="SSC certificate, Board of Intermediate and Secondary Education, Dinajpur" loading="lazy">
        <div><h3>Secondary School Certificate, 2021</h3><p>GPA 5.00 out of 5.00, Science group</p></div>
      </a>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="alt">
  <div class="wrap">
    <h2>Contact</h2>
    <p class="sub">For internships, projects or any question, get in touch</p>
    <div class="contact-grid">
      <div class="card"><h3>Email</h3><p><a href="mailto:tahminazahid@gmail.com">tahminazahid@gmail.com</a></p></div>
      <div class="card"><h3>Location</h3><p>Dhaka, Bangladesh</p></div>
      <div class="card"><h3>LinkedIn</h3><p><a href="https://www.linkedin.com/in/tahmina-zahid" rel="noopener">linkedin.com/in/tahmina-zahid</a></p></div>
    </div>
    <div class="btn-row center" style="margin-top:36px">
      <a class="btn" href="mailto:tahminazahid@gmail.com">Send an email</a>
    </div>
  </div>
</section>

</main>

<footer>© 2026 Tahmina Zahid · E-Portfolio</footer>

</body>
</html>
